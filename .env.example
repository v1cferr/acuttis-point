# Copy to .env and adjust. Never put real credentials in this file — it is
# tracked by git. See README.md for where secrets belong.

# --- Credentials (required, and never stored here) ----------------------------
# The login and password of the Acuttis sign-in form. In production these are
# injected by the host secret store (sops / NixOS secrets / Bitwarden), not
# written to any file in this repository.
ACUTTIS_USERNAME=you@example.com
ACUTTIS_PASSWORD=replace-me

# --- Schedule (required) -----------------------------------------------------
# The time each punch of the day is expected at, as HH:MM. The four times must
# run forward through the day.
#
# When the timer spreads punches over a jitter window (scripts/schedule.sh, or
# services.acuttis-point.jitterSeconds), a punch lands between its time here and
# that many minutes later — never before. systemd can only delay, never bring
# forward, and that decides how to write these:
#
#   ENTRY_TIME and LUNCH_END  =  the time you want, MINUS the jitter
#   LUNCH_START and EXIT_TIME =  the time you want
#
# Then entry and the return from lunch land at or before their wanted times,
# while lunch start and exit land at or after theirs, so the worked day only
# ever comes out at or above nominal. The example below is a 08:00 to 17:30 day
# with a 09:00 to 14:00 lunch and nine minutes of jitter.
ENTRY_TIME=07:51
LUNCH_START=12:00
LUNCH_END=13:51
EXIT_TIME=17:30

# --- Rules -------------------------------------------------------------------
# Days the automation may act on. Default: MON,TUE,WED,THU,FRI
WORK_DAYS=MON,TUE,WED,THU,FRI

# How many minutes after a scheduled time a punch may still be registered.
# Outside this window the run aborts instead of registering a wrong time, so
# this is the knob that keeps a late run from backdating a punch.
# Default: 10, maximum: 240
TIME_TOLERANCE_MINUTES=10

# The shortest lunch break this schedule is allowed to be able to produce. A
# floor, not a target: a schedule whose worst case falls under it is refused at
# startup rather than left to come out short on an unlucky day.
#
# The worst case is both windows going the wrong way at once — the punch leaving
# for lunch landing as late as the tolerance allows, and the one returning
# landing as early as its own:
#
#   guaranteed = LUNCH_END - LUNCH_START - TIME_TOLERANCE_MINUTES
#
# Default: 60, the legal minimum in Brazil for a day over six hours.
MIN_LUNCH_MINUTES=60

# IANA timezone the schedule is written in. Default: America/Sao_Paulo
TIMEZONE=America/Sao_Paulo

# Holidays, vacation and any other day without an expedient, as YYYY-MM-DD.
# Optional; leave unset when there is nothing to skip.
# SKIP_DATES=2026-09-07,2026-12-25

# End-of-day check, after the last window has closed. It cannot register
# anything — every window is shut by then — so the only outcomes left are
# silence on a finished day and a loud refusal naming the punch that is missing.
#
# The reason it exists: a run that fails at midday notifies once, and a
# notification missed is a punch forgotten. This asks again at the end of the
# day, which is the whole point of automating this in the first place.
#
# Leave unset for no sweep. Must be after EXIT_TIME plus the tolerance.
SWEEP_TIME=18:30

# --- Behaviour ---------------------------------------------------------------
# Sign in, describe the page, and stop. Clicks no punch control at all, so it
# is safe to run against your real account at any time of day — it cannot
# register a punch. This is how you find PUNCH_LIST_SELECTOR below.
# Does not require PUNCH_LIST_SELECTOR. Default: false
DISCOVER=false

# Decide and log, but never register a punch. Default: false
DRY_RUN=false

# Run the browser without a window. Set to false to watch a run, which is how
# the punch selectors below get found the first time. Default: true
HEADLESS=true

# How long any single browser step may take. Default: 30, range: 5..300
STEP_TIMEOUT_SECONDS=30

# Acuttis base url. Must be https. Default: https://app.acuttis.com.br
# ACUTTIS_URL=https://app.acuttis.com.br

# Where to keep the browser's cookies between runs, so four punches a day do not
# mean four sign-ins — which is what invites a lockout or a 2FA challenge.
#
# THIS FILE IS A CREDENTIAL: it stands in for the password until the session
# expires. Written 0600, and git ignores anything matching *session*.json. Under
# systemd, put it in the service's StateDirectory.
# A file that is corrupt or unreadable is thrown away and the run signs in
# normally, so it can always be deleted.

# Where to drop a screenshot when a run breaks — the page at that moment is the
# only witness to an interface that changed. Sent along with the notification.
#
# A refusal is NOT photographed: it is a decision rather than a malfunction, and
# a late run refusing its window every day would fill the disk.
#
# The punch modal shows a full name and a CPF, so these files are personal data.
# Written 0600.
# SCREENSHOT_DIR=/var/lib/acuttis-point/screenshots

# --- Notifications -----------------------------------------------------------
# Where to POST a push notification for each run. Shaped for ntfy: the title,
# priority and tags go as headers and the record goes as the body, so any
# endpoint taking a POST works.
#
# On ntfy the topic name is the only thing protecting it — anyone who knows it
# can read and publish. Use a random one, not "acuttis":
#
#   openssl rand -hex 10
#
# The message says which punch and at what time, so it does reach ntfy's
# servers in the clear. Self-host if that matters.
# NOTIFY_URL=https://ntfy.sh/replace-with-something-random

# Which runs are worth a phone buzzing. Default: action
#
#   always   every run, including the ones that found nothing to do
#   action   ran and did something, or could not — silent when there was
#            nothing to do, which is the common case after a manual punch
#   problem  only failures and refusals
NOTIFY_ON=action

# --- Selectors ---------------------------------------------------------------
# Acuttis renders its interface in the browser, so the automation needs to be
# told where to click. Every default below was read from the live application
# while signed in, and none of them normally needs setting.
#
# Reaching the punches takes two steps: an anchor opens the punch modal, and a
# button inside it switches to the receipt, which is the only place they are
# listed. The receipt shows several days at once, newest first.
#
# USERNAME_SELECTOR=input#username
# PASSWORD_SELECTOR=input#password
# SUBMIT_SELECTOR=form.login-form button[type=submit]
# PUNCH_TRIGGER_SELECTOR=a.size-item-navbar
# PUNCH_MODAL_SELECTOR=#mark_modal
# PUNCH_RECEIPT_SELECTOR=#mark_modal button:text-is("Comprovante de ponto")
# PUNCH_BACK_SELECTOR=#mark_modal button:text-is("Voltar")
# PUNCH_BUTTON_SELECTOR=#mark_modal button:text-is("Ponto")

# The fragile one: its class is generated by CSS modules, so it will stop
# matching when the Acuttis frontend is rebuilt. That is survivable rather than
# dangerous — the receipt spans several days, so a selector that no longer
# matches produces no rows at all, which is reported as an interface change
# instead of passing for a day that never started. Run DISCOVER=true to find
# the replacement.
# PUNCH_LIST_SELECTOR=div.styles_containerMarkingAddress__lLpPc

# The trigger, receipt and back selectors can be set to nothing on purpose,
# which means "this step is not needed here" — for a deployment where the
# punches are already on screen. The others fall back to their default when
# left blank.

# Rehearse instead of punching: sign in, read today's punches and check that the
# punch button would accept a click, then stop one step short of clicking it.
# Reports READY or NOT_READY and notifies either way, ignoring NOTIFY_ON —
# hearing that the next punch will work is the whole reason it runs.
# `scripts/schedule.sh` installs a separate timer that sets this 15 minutes
# before each punch, so it normally stays false here.
PREFLIGHT=false

# Send the browser's traffic out through this ssh host, so the punch reaches
# Acuttis from that machine's address rather than this one's. A punch is a record
# of having been at work, and the address it comes from is part of that record.
#
# `scripts/with-fai-proxy.sh` opens a SOCKS tunnel over ssh for the length of one
# run and closes it after: no route changes, no system-wide VPN left on, nothing
# else on this machine pointed at it. A Host block in ~/.ssh/config, or
# user@address. Empty goes out from here.
#
# It fails closed — no tunnel means no punch, rather than a punch quietly sent
# from the wrong place. The rehearsal fifteen minutes earlier uses the same
# tunnel, so a broken path is heard about with time to act.
PROXY_SSH_HOST=

# Set directly instead, to point the browser at a proxy this project does not
# manage. The wrapper above sets it itself.
# PROXY_SERVER=socks5://127.0.0.1:11080

# Where a tap on the notification's button publishes to, and where the listener
# service waits for it. Anything that can publish here can spend a token, so use
# a random topic — and note that a token is still needed, is good for one punch,
# and expires when the window does.
COMMAND_URL=

# Ask instead of punching: decide as usual, then offer a one-time token and let a
# tap spend it. `scripts/schedule.sh` sets this on the timer that asks, so it
# normally stays false here.
ASK=false

# Where the token waits. Whoever can read it can spend it, so it is written 0600
# and belongs beside the rest of this project's state.
# PENDING_FILE=state/pending.json
